<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.QRSpliter" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Light Theme Colors -->
        <item name="colorPrimary">@color/monochrome_black</item>
        <item name="colorOnPrimary">@color/monochrome_white</item>
        <item name="colorPrimaryContainer">@color/monochrome_surface_variant_light</item>
        <item name="colorOnPrimaryContainer">@color/monochrome_black</item>
        <item name="colorSecondary">@color/monochrome_gray_dark</item>
        <item name="colorOnSecondary">@color/monochrome_white</item>
        <item name="colorSecondaryContainer">@color/monochrome_surface_variant_light</item>
        <item name="colorOnSecondaryContainer">@color/monochrome_off_black</item>
        <item name="android:colorBackground">@color/monochrome_off_white</item>
        <item name="colorOnBackground">@color/monochrome_off_black</item>
        <item name="colorSurface">@color/monochrome_white</item>
        <item name="colorOnSurface">@color/monochrome_off_black</item>
        <item name="colorSurfaceVariant">@color/monochrome_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/monochrome_gray_muted</item>
        <item name="colorOutline">@color/monochrome_border_light</item>
        <item name="colorOutlineVariant">@color/monochrome_surface_variant_light</item>
        <item name="colorError">#E11D48</item>
        <item name="colorOnError">@color/monochrome_white</item>

        <!-- Status & Navigation Bar Styling -->
        <item name="android:statusBarColor">@color/monochrome_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/monochrome_white</item>

        <!-- Material Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.QRSpliter.Card</item>
        <item name="materialButtonStyle">@style/Widget.QRSpliter.Button</item>
        <item name="textInputStyle">@style/Widget.QRSpliter.TextInputLayout</item>
    </style>

    <style name="Theme.QRSpliter" parent="Base.Theme.QRSpliter" />

    <!-- Custom Component Styles -->
    <style name="Widget.QRSpliter.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="Widget.QRSpliter.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.QRSpliter.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="placeholderTextColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
